// Compute shader: Convert RGBA render target to I420 (Y plane, U plane, V plane)
// Bindings:
// t0 - InputTexture (RGBA float4)
// s0 - Sampler
// u0 - RWTexture2D<uint> OutY (size: W x H)    -> low 8 bits = Y
// u1 - RWTexture2D<uint> OutU (size: W/2 x H/2) -> low 8 bits = U
// u2 - RWTexture2D<uint> OutV (size: W/2 x H/2) -> low 8 bits = V
// cb0 - CSConstants (int2 TextureSize)
#define DEBUG_WRITE_RGB 0
#define DEBUG_WRITE_TESTPATTERN 1

cbuffer CSConstants : register(b0)
{
    int2 TextureSize; // x = width (must be even), y = height (must be even)
};

Texture2D<float4> InputTexture : register(t0);
SamplerState InputSampler : register(s0);

RWTexture2D<uint> OutY : register(u0);
RWTexture2D<uint> OutU : register(u1);
RWTexture2D<uint> OutV : register(u2);

[numthreads(16,16,1)]
void CSMain(uint3 DTid : SV_DispatchThreadID)
{
    int x = DTid.x;
    int y = DTid.y;
    int W = TextureSize.x;
    int H = TextureSize.y;

    if (x >= W || y >= H)
        return;

    // Sample the input at this pixel using integer load to avoid any sampler filtering
    float4 c = InputTexture.Load(int3(x, y, 0));

    // Convert to 0..255 range
    float r = saturate(c.r) * 255.0;
    float g = saturate(c.g) * 255.0;
    float b = saturate(c.b) * 255.0;

    // Debug helper: define DEBUG_WRITE_RGB to 1 to write raw R/G/B into Y/U/V planes
#ifndef DEBUG_WRITE_RGB
#define DEBUG_WRITE_RGB 0
#endif

    // Debug helper: write a deterministic test pattern into the planes
    #ifndef DEBUG_WRITE_TESTPATTERN
    #define DEBUG_WRITE_TESTPATTERN 0
    #endif

#if DEBUG_WRITE_RGB
    // Quick debug: write per-channel into the three planes so you can verify sampling
    uint Yr = (uint)round(clamp(r, 0.0, 255.0));
    uint Ug = (uint)round(clamp(g, 0.0, 255.0));
    uint Vb = (uint)round(clamp(b, 0.0, 255.0));
    OutY[int2(x, y)] = (Yr & 0xFF);
    if ((x % 2) == 0 && (y % 2) == 0)
    {
        int2 uvCoord = int2(x / 2, y / 2);
        OutU[uvCoord] = (Ug & 0xFF);
        OutV[uvCoord] = (Vb & 0xFF);
    }
    return;
#endif

#if DEBUG_WRITE_TESTPATTERN
    // Write a recognizable 32-bit magic value so readback bytes are easy to find
    // Low 8 bits will be visible in byte-packed YUV dumps (e.g., 0x44)
    const uint MAGIC = 0x11223344u;
    OutY[int2(x, y)] = MAGIC;
    if ((x % 2) == 0 && (y % 2) == 0)
    {
        int2 uvCoord = int2(x / 2, y / 2);
        OutU[uvCoord] = MAGIC;
        OutV[uvCoord] = MAGIC;
    }
    return;
#endif

    // BT.601 limited-range luma (matches many video pipelines)
    float Yf = (0.257 * r + 0.504 * g + 0.098 * b) + 16.0;
    uint Y = (uint)round(clamp(Yf, 0.0, 255.0));

    // Write Y plane (low 8 bits)
    OutY[int2(x, y)] = (Y & 0xFF);

    // Compute U and V for each 2x2 block (chrominance is subsampled)
    if ((x % 2) == 0 && (y % 2) == 0)
    {
        int2 p00 = int2(x, y);
        int2 p10 = int2(min(x + 1, W - 1), y);
        int2 p01 = int2(x, min(y + 1, H - 1));
        int2 p11 = int2(min(x + 1, W - 1), min(y + 1, H - 1));

        float4 c00 = InputTexture.Load(int3(p00, 0));
        float4 c10 = InputTexture.Load(int3(p10, 0));
        float4 c01 = InputTexture.Load(int3(p01, 0));
        float4 c11 = InputTexture.Load(int3(p11, 0));

        // Average the four samples and convert to 0..255
        float rAvg = (c00.r + c10.r + c01.r + c11.r) * 0.25 * 255.0;
        float gAvg = (c00.g + c10.g + c01.g + c11.g) * 0.25 * 255.0;
        float bAvg = (c00.b + c10.b + c01.b + c11.b) * 0.25 * 255.0;

        // BT.601 RGB -> YUV (studio range) -> compute Cb (U) and Cr (V)
        float Uf = (-(0.148f * rAvg) - (0.291f * gAvg) + (0.439f * bAvg) + 128.0f);
        float Vf = (( 0.439f * rAvg) - (0.368f * gAvg) - (0.071f * bAvg) + 128.0f);

        uint U = (uint)round(clamp(Uf, 0.0, 255.0));
        uint V = (uint)round(clamp(Vf, 0.0, 255.0));

        int2 uvCoord = int2(x / 2, y / 2);
        OutU[uvCoord] = (U & 0xFF);
        OutV[uvCoord] = (V & 0xFF);
    }
}
